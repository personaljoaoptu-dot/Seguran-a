# AegisEye AI Dashboard - Git Ignore

# Python runtime & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
python311/

# PyInstaller & Build artifacts
build/
dist/
*.spec

# Temp, scratch & debug files
scratch/
*.log
*.tmp
evidencias/*.mp4
evidencias/*.png
evidencias/*.jpg

# Environment & Credentials
.env
.env.*
*.pem
*.key

# System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor files
.vscode/*
!.vscode/tasks.json
.idea/
*.swp

# Installers / One-off scripts
install_python.ps1
get_python_embed.ps1
test_fetch.js
